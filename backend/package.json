{
  "name": "campusx-backend",
  "version": "1.0.0",
  "description": "CAMPUS-X Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:seed-7th": "ts-node -r tsconfig-paths/register prisma/seed-7th-sem.ts",
    "db:seed-5th": "ts-node -r tsconfig-paths/register prisma/seed-5th-sem.ts",
    "db:seed-3rd": "ts-node -r tsconfig-paths/register prisma/seed-3rd-sem.ts",
    "db:seed-campus": "ts-node -r tsconfig-paths/register prisma/seed-real-campus.ts",
    "db:cleanup": "ts-node -r tsconfig-paths/register prisma/cleanup-fake-faculty.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true
  }
}
